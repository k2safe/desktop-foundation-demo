{
  "name": "desktop-commerce-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "pnpm type-check && pnpm build:web",
    "build:web": "vite build",
    "build:desktop": "tauri build && desktop-foundation-ci --no-type-check --no-build --package-desktop --manifest --release-plan --github-repo k2safe/desktop-foundation-demo --preview-bundle-id com.k2safe.desktopcommerce.demo.preview --preview-name \"Desktop Commerce Demo Preview\"",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "ci": "desktop-foundation-ci --integration-check && desktop-foundation-ci --type-check --build --strict",
    "package:desktop": "desktop-foundation-ci --no-type-check --no-build --package-desktop --manifest --release-plan --github-repo k2safe/desktop-foundation-demo --preview-bundle-id com.k2safe.desktopcommerce.demo.preview --preview-name \"Desktop Commerce Demo Preview\"",
    "check:foundation": "desktop-foundation-ci --integration-check"
  },
  "dependencies": {
    "@desktop-foundation/app-shell": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-app-shell-0.1.6.tgz",
    "@desktop-foundation/bridge": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-bridge-0.1.6.tgz",
    "@desktop-foundation/theme-presets": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-theme-presets-0.1.6.tgz",
    "@desktop-foundation/ui-react": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-ui-react-0.1.6.tgz",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "~5.8.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@desktop-foundation/create-desktop-app": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-create-desktop-app-0.1.6.tgz",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  },
  "pnpm": {
    "overrides": {
      "@desktop-foundation/app-shell": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-app-shell-0.1.6.tgz",
      "@desktop-foundation/bridge": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-bridge-0.1.6.tgz",
      "@desktop-foundation/theme-presets": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-theme-presets-0.1.6.tgz",
      "@desktop-foundation/ui-react": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-ui-react-0.1.6.tgz",
      "@desktop-foundation/create-desktop-app": "https://raw.githubusercontent.com/k2safe/desktop-foundation/main/artifacts/npm/desktop-foundation-create-desktop-app-0.1.6.tgz"
    }
  }
}
